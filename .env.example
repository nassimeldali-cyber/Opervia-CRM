# Opervia Environment Configuration
PORT=3000
NODE_ENV="development"
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string"
DATA_DIR="./data"

# Optional external credentials (configured per tenant or globally for platform services)
WHATSAPP_CLOUD_API_VERSION="v20.0"
WHATSAPP_SYSTEM_VERIFY_TOKEN="opervia_webhook_verify_token_sample"
WHATSAPP_APP_SECRET="sample_meta_app_secret_for_hmac_sha256"

# E-commerce Webhook Secret Defaults
WOOCOMMERCE_WEBHOOK_SECRET="sample_wc_webhook_secret_key"

# Storage & Backups
BACKUP_ENABLED="true"
BACKUP_INTERVAL_HOURS="24"
